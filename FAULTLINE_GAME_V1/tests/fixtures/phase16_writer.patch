+                    throw std::runtime_error("Prologue replay mismatch at seed " + std::to_string(seed));
+            }
+
+            if (inspectPath == std::to_string(seed)) {
+                std::cout << "BaseWorldHash: " << std::hex << world::baseWorldHash(*state.world.base) << std::dec << "\n";
+            }
