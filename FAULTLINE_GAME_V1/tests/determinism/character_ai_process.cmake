if(NOT DEFINED CHARACTER_AI)
  message(FATAL_ERROR "CHARACTER_AI executable missing")
endif()
set(a "${CMAKE_CURRENT_BINARY_DIR}/character-ai-a.flsave")
set(b "${CMAKE_CURRENT_BINARY_DIR}/character-ai-b.flsave")
execute_process(COMMAND "${CHARACTER_AI}" --seed 12345 --ticks 1200 --save "${a}"
  RESULT_VARIABLE ar OUTPUT_VARIABLE ao ERROR_VARIABLE ae)
execute_process(COMMAND "${CHARACTER_AI}" --seed 12345 --ticks 1200 --save "${b}"
  RESULT_VARIABLE br OUTPUT_VARIABLE bo ERROR_VARIABLE be)
if(NOT ar EQUAL 0 OR NOT br EQUAL 0)
  message(FATAL_ERROR "Character AI process failed: ${ar}/${br}\n${ae}\n${be}")
endif()
if(NOT ao STREQUAL bo)
  message(FATAL_ERROR "Character AI stdout differs\nA:\n${ao}\nB:\n${bo}")
endif()
file(SHA256 "${a}" ah)
file(SHA256 "${b}" bh)
if(NOT ah STREQUAL bh)
  message(FATAL_ERROR "Character AI saves differ: ${ah} vs ${bh}")
endif()
file(REMOVE "${a}" "${b}")
message(STATUS "Character AI process determinism PASS; SHA-256 ${ah}")
