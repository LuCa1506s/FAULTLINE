execute_process(COMMAND "${PROLOGUE}" --seed 12345 --save prologue-process-a.flsave --verbose
  RESULT_VARIABLE result_a OUTPUT_VARIABLE output_a ERROR_VARIABLE error_a)
execute_process(COMMAND "${PROLOGUE}" --seed 12345 --save prologue-process-b.flsave --verbose
  RESULT_VARIABLE result_b OUTPUT_VARIABLE output_b ERROR_VARIABLE error_b)
if(NOT result_a STREQUAL "0" OR NOT result_b STREQUAL "0")
  message(FATAL_ERROR "Prologue startup/validation failed: ${result_a}, ${result_b}: ${error_a} ${error_b}")
endif()
if(NOT output_a STREQUAL output_b)
  message(FATAL_ERROR "Prologue output differs between independent processes: ${output_a} vs ${output_b}")
endif()
file(SHA256 prologue-process-a.flsave hash_a)
file(SHA256 prologue-process-b.flsave hash_b)
if(NOT hash_a STREQUAL hash_b)
  message(FATAL_ERROR "Prologue save bytes differ between independent processes")
endif()
if(NOT output_a MATCHES "Validation: PASS")
  message(FATAL_ERROR "Prologue did not validate")
endif()
if(NOT output_a MATCHES "StateHash: [0-9a-f]+")
  message(FATAL_ERROR "Prologue did not produce a StateHash")
endif()
