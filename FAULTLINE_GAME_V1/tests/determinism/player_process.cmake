execute_process(COMMAND "${PLAYER}" --seed 12345 --ticks 12000 --save player-process-a.flsave
  RESULT_VARIABLE result_a OUTPUT_VARIABLE output_a ERROR_VARIABLE error_a)
execute_process(COMMAND "${PLAYER}" --seed 12345 --ticks 12000 --save player-process-b.flsave
  RESULT_VARIABLE result_b OUTPUT_VARIABLE output_b ERROR_VARIABLE error_b)
if(NOT result_a STREQUAL "0" OR NOT result_b STREQUAL "0")
  message(FATAL_ERROR "Prologue with player state failed: ${result_a}, ${result_b}: ${error_a} ${error_b}")
endif()
if(NOT output_a STREQUAL output_b)
  message(FATAL_ERROR "Prologue output differs between independent processes")
endif()
file(SHA256 player-process-a.flsave hash_a)
file(SHA256 player-process-b.flsave hash_b)
if(NOT hash_a STREQUAL hash_b)
  message(FATAL_ERROR "Save bytes differ between independent processes")
endif()
if(NOT output_a MATCHES "Validation: PASS")
  message(FATAL_ERROR "Prologue with player did not validate")
endif()
if(NOT output_a MATCHES "StateHash: [0-9a-f]+")
  message(FATAL_ERROR "No StateHash produced")
endif()
