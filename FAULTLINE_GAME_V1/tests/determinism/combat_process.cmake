execute_process(COMMAND "${COMBAT}" --seed 12345 --rounds 6 OUTPUT_VARIABLE A RESULT_VARIABLE RA)
execute_process(COMMAND "${COMBAT}" --seed 12345 --rounds 6 OUTPUT_VARIABLE B RESULT_VARIABLE RB)
if(NOT RA EQUAL 0 OR NOT RB EQUAL 0)
  message(FATAL_ERROR "combat process failed: ${RA}/${RB}")
endif()
if(NOT A STREQUAL B)
  message(FATAL_ERROR "combat process output differs\nA=${A}\nB=${B}")
endif()
if(NOT A MATCHES "Attack attempts: [1-9]" OR NOT A MATCHES "Validation: PASS")
  message(FATAL_ERROR "combat scenario did not execute: ${A}")
endif()
