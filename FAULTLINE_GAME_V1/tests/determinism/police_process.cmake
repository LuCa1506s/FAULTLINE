set(a "${CMAKE_CURRENT_BINARY_DIR}/police_a.flsave")
set(b "${CMAKE_CURRENT_BINARY_DIR}/police_b.flsave")
execute_process(COMMAND "${POLICE}" --seed 12345 --ticks 240 --save "${a}" RESULT_VARIABLE ra OUTPUT_VARIABLE oa ERROR_VARIABLE ea)
execute_process(COMMAND "${POLICE}" --seed 12345 --ticks 240 --save "${b}" RESULT_VARIABLE rb OUTPUT_VARIABLE ob ERROR_VARIABLE eb)
if(NOT ra EQUAL 0 OR NOT rb EQUAL 0)
  message(FATAL_ERROR "Police process failed: ${ra}/${rb} ${ea} ${eb}")
endif()
if(NOT oa STREQUAL ob)
  message(FATAL_ERROR "Police process stdout differs")
endif()
file(SHA256 "${a}" ha)
file(SHA256 "${b}" hb)
if(NOT ha STREQUAL hb OR NOT oa MATCHES "Crimes: [1-9]" OR NOT oa MATCHES "Reports: [1-9]" OR NOT oa MATCHES "Police responses: [1-9]" OR NOT oa MATCHES "Validation: PASS")
  message(FATAL_ERROR "Police process did not exercise deterministic Phase 20 behavior")
endif()
message(STATUS "Police process determinism PASS SHA256=${ha}")
