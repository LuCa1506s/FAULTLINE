from enum import Enum
from pathlib import Path

class SnapshotError(RuntimeError): ...

class WorldProfile(Enum):
    STANDARD = 0
    COMPACT = 1

class Config:
    def __init__(self, profile: WorldProfile = ...) -> None: ...
    @property
    def profile(self) -> WorldProfile: ...

class Action(Enum):
    IDLE = 0
    EAST = 1
    WEST = 2
    SOUTH = 3
    NORTH = 4

class Status(Enum):
    RUNNING = 0
    INCAPACITATED = 1
    TICK_LIMIT = 2

class EventKind(Enum):
    OPERATION_CREATED = 0
    OPERATION_STARTED = 1
    OPERATION_RESOLVED = 2
    OPERATION_FAILED = 3
    OPERATION_CANCELLED = 4
    TERRITORY_CHANGED = 5

class Point:
    @property
    def x(self) -> float: ...
    @property
    def z(self) -> float: ...

class Observation:
    @property
    def tick(self) -> int: ...
    @property
    def position(self) -> Point: ...
    @property
    def health(self) -> float: ...
    @property
    def status(self) -> Status: ...

class RoadEdge:
    @property
    def first(self) -> int: ...
    @property
    def second(self) -> int: ...

class RoadMap:
    @property
    def nodes(self) -> list[Point]: ...
    @property
    def edges(self) -> list[RoadEdge]: ...

class Event:
    @property
    def tick(self) -> int: ...
    @property
    def kind(self) -> EventKind: ...
    @property
    def subject(self) -> int: ...

class StepResult:
    @property
    def observation(self) -> Observation: ...
    @property
    def ticks(self) -> int: ...
    @property
    def events(self) -> list[Event]: ...
    @property
    def events_truncated(self) -> bool: ...

class Simulation:
    def __init__(self, seed: int = ..., config: Config = ...) -> None: ...
    def reset(self, seed: int, config: Config = ...) -> None: ...
    def observe(self) -> Observation: ...
    def road_map(self) -> RoadMap: ...
    def step(self, action: Action, ticks: int = ...) -> StepResult: ...
    def advance(self, ticks: int) -> StepResult: ...
    def state_hash(self) -> int: ...
    def snapshot(self) -> bytes: ...
    def restore(self, data: bytes) -> None: ...
    def save(self, path: str | Path) -> None: ...
    def load(self, path: str | Path) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Simulation: ...
    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> None: ...
