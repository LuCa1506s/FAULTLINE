function(run_map name)
  execute_process(COMMAND "${MAP2D}" ${ARGN} --output "${CMAKE_CURRENT_BINARY_DIR}/${name}.svg"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${name} failed (${result}): ${stdout} ${stderr}")
  endif()
  file(READ "${CMAKE_CURRENT_BINARY_DIR}/${name}.svg" content)
  set(${name}_OUT "${stdout}" PARENT_SCOPE)
  set(${name}_SVG "${content}" PARENT_SCOPE)
endfunction()

run_map(raw_a --seed 12345 --labels)
run_map(raw_b --seed 12345 --labels --diagnostics)
if(NOT raw_a_SVG STREQUAL raw_b_SVG)
  message(FATAL_ERROR "Raw seed SVG differs across processes/diagnostics")
endif()
foreach(expected IN ITEMS "Mode: Generated world" "Road edges: 391" "Buildings: 8007" "Player: 0 (absent: raw generated-world mode)")
  string(FIND "${raw_a_OUT}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Raw output missing: ${expected}")
  endif()
endforeach()
foreach(expected IN ITEMS "id=\"world-bounds\"" "id=\"water-1\"" "id=\"road-edge-391\"" "id=\"building-8007\"" "id=\"territory-41\"" "id=\"semantic-npc-22\"")
  string(FIND "${raw_a_SVG}" "${expected}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Raw SVG missing emitted geometry: ${expected}")
  endif()
endforeach()
string(REGEX MATCHALL "id=\"road-edge-[0-9]+\"" roads "${raw_a_SVG}")
list(LENGTH roads road_count)
string(REGEX MATCHALL "id=\"building-[0-9]+\"" buildings "${raw_a_SVG}")
list(LENGTH buildings building_count)
string(REGEX MATCHALL "id=\"parcel-[0-9]+\"" parcels "${raw_a_SVG}")
list(LENGTH parcels parcel_count)
string(REGEX MATCHALL "id=\"territory-[0-9]+\"" territories "${raw_a_SVG}")
list(LENGTH territories territory_count)
if(NOT road_count EQUAL 391 OR NOT building_count EQUAL 8007 OR NOT parcel_count EQUAL 8007 OR NOT territory_count EQUAL 41)
  message(FATAL_ERROR "Emitted counts differ: roads=${road_count} buildings=${building_count} parcels=${parcel_count} territories=${territory_count}")
endif()
if(raw_a_SVG MATCHES "[Nn][Aa][Nn]|[Ii][Nn][Ff]" OR NOT raw_a_SVG MATCHES "<svg [^>]*viewBox=\"0 0 1200 1104\"" OR NOT raw_a_SVG MATCHES "</svg>")
  message(FATAL_ERROR "Malformed/non-finite SVG")
endif()

run_map(runtime_a --seed 12345 --runtime --labels)
run_map(runtime_b --seed 12345 --runtime --labels)
if(NOT runtime_a_SVG STREQUAL runtime_b_SVG OR NOT runtime_a_OUT MATCHES "Player: 1" OR NOT runtime_a_OUT MATCHES "Active NPCs: [1-9]")
  message(FATAL_ERROR "Runtime mode is missing deterministic real player/residency")
endif()
if(NOT runtime_a_SVG MATCHES "id=\"player-marker\" data-entity=\"[0-9]+\"" OR
   NOT runtime_a_SVG MATCHES "data-world-x=\"1638.00\" data-world-z=\"2714.50\" data-yaw=\"0.000000\" data-cx=\"781.82\" data-cy=\"753.31\"" OR
   NOT runtime_a_SVG MATCHES "x1=\"781.82\" y1=\"753.31\" x2=\"781.82\" y2=\"761.31\"[^>]*id=\"player-dir\"" OR
   NOT runtime_a_SVG MATCHES "id=\"active-npc-[0-9]+\"")
  message(FATAL_ERROR "Runtime SVG lacks source-addressable player/NPC markers")
endif()

execute_process(COMMAND "${COMBAT}" --seed 12345 --rounds 6 --save "${CMAKE_CURRENT_BINARY_DIR}/map2d_v13.flsave"
  RESULT_VARIABLE combat_result OUTPUT_VARIABLE combat_out ERROR_VARIABLE combat_err)
if(NOT combat_result EQUAL 0)
  message(FATAL_ERROR "Could not create current v13 save: ${combat_out} ${combat_err}")
endif()
run_map(save_a --load "${CMAKE_CURRENT_BINARY_DIR}/map2d_v13.flsave" --labels)
run_map(save_b --load "${CMAKE_CURRENT_BINARY_DIR}/map2d_v13.flsave" --labels)
if(NOT save_a_SVG STREQUAL save_b_SVG OR NOT save_a_OUT MATCHES "Mode: Loaded save" OR NOT save_a_OUT MATCHES "Player: 1" OR NOT save_a_OUT MATCHES "Active NPCs: [1-9]" OR NOT save_a_SVG MATCHES "SaveFormatVersion: 13")
  message(FATAL_ERROR "Current v13 load rendering failed")
endif()
run_map(legacy_v12 --load "${V12}")
if(NOT legacy_v12_SVG MATCHES "SaveFormatVersion: 12" OR NOT legacy_v12_OUT MATCHES "Validation: PASS")
  message(FATAL_ERROR "Authentic v12 migration rendering failed")
endif()

run_map(no_layers --seed 12345 --no-buildings --no-parcels --no-territories --no-npcs)
if(no_layers_SVG MATCHES "id=\"building-" OR no_layers_SVG MATCHES "id=\"parcel-" OR no_layers_SVG MATCHES "id=\"territory-" OR no_layers_SVG MATCHES "id=\"semantic-npc-")
  message(FATAL_ERROR "Disabled layer emitted geometry")
endif()

function(expect_bad)
  execute_process(COMMAND "${MAP2D}" ${ARGN} RESULT_VARIABLE bad_result OUTPUT_QUIET ERROR_QUIET)
  if(bad_result EQUAL 0)
    message(FATAL_ERROR "Malformed CLI unexpectedly succeeded: ${ARGN}")
  endif()
endfunction()
expect_bad(--seed 1 --load missing.flsave --output x.svg)
expect_bad(--seed nope --output x.svg)
expect_bad(--seed 1 --width 12 --output x.svg)
expect_bad(--seed 1)
expect_bad(--output x.svg)

message(STATUS "Map2D actual SVG audit: PASS (raw/runtime/v13 and authentic v12 load, byte-identical, emitted counts verified)")
