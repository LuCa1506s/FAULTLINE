          "status",
          "details"
        ]
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_report": {
      "type": "string"
    },
    "next_phase": {
      "type": "integer"
    }
  },
  "required": [
    "phase",
    "status",
    "summary",
    "files_changed",
    "commands_run",
    "tests",
    "known_limitations",
    "blockers",
    "verification_report",
    "next_phase"
